{
  "name": "starter-react-monorepo",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "license": "MIT",
  "homepage": "https://github.com/yunzhencc/starter-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunzhencc/starter-react.git"
  },
  "bugs": "https://github.com/yunzhencc/starter-react/issues",
  "keywords": [
    "monorepo",
    "turbo",
    "react",
    "react admin"
  ],
  "engines": {
    "node": "^22.18.0 || ^24.12.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "bootstrap": "pnpm install",
    "clean": "tsx ./scripts/clean.ts",
    "start": "turbo run dev",
    "start:admin": "pnpm --filter @yunzhen/app-admin run dev",
    "start:web": "pnpm --filter @yunzhen/app-web run dev",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "check:cspell": "cspell lint \"**/*.ts\" \"**/README.md\" \".changeset/*.md\" --no-progress",
    "test": "vitest",
    "typecheck": "turbo run typecheck",
    "release": "changeset",
    "prepare": "simple-git-hooks",
    "preinstall": "npx only-allow pnpm"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:lint",
    "@changesets/cli": "catalog:dev",
    "@commitlint/cli": "catalog:lint",
    "@commitlint/config-conventional": "catalog:lint",
    "@commitlint/types": "catalog:lint",
    "@eslint-react/eslint-plugin": "catalog:lint",
    "@playwright/test": "catalog:test",
    "@rsbuild/plugin-react": "catalog:dev",
    "@rslib/core": "catalog:dev",
    "@rspress/core": "catalog:dev",
    "@tailwindcss/typography": "catalog:dev",
    "@tailwindcss/vite": "catalog:vite",
    "@tanstack/devtools-vite": "catalog:dev",
    "@tanstack/react-devtools": "catalog:dev",
    "@tanstack/react-router-devtools": "catalog:dev",
    "@tanstack/react-start": "catalog:dev",
    "@tanstack/router-cli": "catalog:dev",
    "@tanstack/router-plugin": "catalog:dev",
    "@testing-library/react": "catalog:test",
    "@testing-library/user-event": "catalog:test",
    "@types/jsdom": "catalog:types",
    "@types/node": "catalog:types",
    "@types/react": "catalog:types",
    "@types/react-dom": "catalog:types",
    "@vitejs/plugin-react": "catalog:vite",
    "@vitest/coverage-v8": "catalog:test",
    "@vitest/ui": "catalog:test",
    "@vitest/web-worker": "catalog:test",
    "code-inspector-plugin": "catalog:vite",
    "cross-env": "catalog:dev",
    "cspell": "catalog:lint",
    "eslint": "catalog:lint",
    "eslint-plugin-format": "catalog:lint",
    "eslint-plugin-react-refresh": "catalog:lint",
    "jsdom": "catalog:test",
    "lint-staged": "catalog:dev",
    "playwright": "catalog:test",
    "react-grab": "catalog:dev",
    "react-scan": "catalog:dev",
    "rollup-plugin-bundle-stats": "catalog:dev",
    "rollup-plugin-visualizer": "catalog:dev",
    "simple-git-hooks": "catalog:dev",
    "tailwindcss": "catalog:dev",
    "tsx": "catalog:typescript",
    "turbo": "catalog:dev",
    "tw-animate-css": "catalog:dev",
    "typed-query-selector": "catalog:typescript",
    "typescript": "catalog:typescript",
    "unplugin-auto-import": "catalog:vite",
    "vite": "catalog:vite",
    "vite-plugin-html": "catalog:vite",
    "vitest": "catalog:test"
  },
  "simple-git-hooks": {
    "commit-msg": "npx --no -- commitlint --edit $1",
    "pre-commit": "npx lint-staged",
    "preserveUnused": [
      "commit-msg"
    ]
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
